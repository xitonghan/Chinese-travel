      "id": "lesson_01",
      "path": "survival",
      "title": {
        "ar": "في المطار",
        "en": "At the Airport"
      },
      "steps": [
        {
          "type": "dialogue",
          "turns": [
            {
              "speaker": "staff",
              "zh": "你好！欢迎来到中国。",
              "pinyin": "Nǐ hǎo! Huānyíng lái dào Zhōngguó.",
              "ar": "مرحباً! أهلاً بك في الصين.",
              "en": "Hello! Welcome to China.",
              "audio": "l01_s01_normal.mp3"
            },
            {
              "speaker": "you",
              "zh": "你好，我是来出差的。",
              "pinyin": "Nǐ hǎo, wǒ shì lái chūchāi de.",
              "ar": "مرحباً، أنا هنا في رحلة عمل.",
              "en": "Hello, I'm here on a business trip.",
              "audio": "l01_s02_normal.mp3"
            },
            {
              "speaker": "staff",
              "zh": "请出示您的护照。",
              "pinyin": "Qǐng chūshì nín de hùzhào.",
              "ar": "يُرجى إبراز جواز السفر.",
              "en": "Please show your passport.",
              "audio": "l01_s03_normal.mp3"
            },
            {
              "speaker": "you",
              "zh": "谢谢。请问登机口在哪里？",
              "pinyin": "Xièxie. Qǐngwèn dēngjīkǒu zài nǎlǐ?",
              "ar": "شكراً. أين بوابة الصعود؟",
              "en": "Thanks. Where is the boarding gate?",
              "audio": "l01_s04_normal.mp3"
            },
            {
              "speaker": "staff",
              "zh": "请稍等。",
              "pinyin": "Qǐng shāo děng.",
              "ar": "لحظة، من فضلك.",
              "en": "One moment, please.",
              "audio": "l01_s08_normal.mp3"
            },
            {
              "speaker": "you",
              "zh": "太好了，谢谢您！",
              "pinyin": "Tài hǎo le, xièxie nín!",
              "ar": "هذا رائع، شكراً!",
              "en": "Wonderful, thank you!",
              "audio": "l01_s10_normal.mp3"
            }
          ]
        },
        {
